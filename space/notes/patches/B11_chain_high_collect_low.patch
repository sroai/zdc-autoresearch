+// "chain high, collect low": grow the surviving clusters by the items (collected hits and sub-floor
+// groups) that neighbour them, pass by pass. In each pass an item joins the cluster that owns its most
+// energetic neighbouring hit among the hits attached in the previous pass (ties: lower hit index), so
+// the outcome does not depend on the item order and two clusters never merge. Items that never touch
+// a cluster are dropped, as the stock algorithm drops them.
+void ImagingTopoCluster::collect(const edm4eic::CalorimeterHitCollection& hits,
+                                 std::vector<std::vector<std::size_t>>& clusters,
+                                 std::vector<std::vector<std::size_t>>& items) const {
+  // the hits attached in the previous pass, with their cluster
+  std::vector<std::pair<std::size_t, std::size_t>> frontier;
+  for (std::size_t c = 0; c < clusters.size(); ++c) {
+    for (std::size_t idx : clusters[c]) {
+      frontier.emplace_back(idx, c);
+    }
+  }
+  std::vector<bool> attached(items.size(), false);
+  while (!frontier.empty()) {
+    std::vector<std::pair<std::size_t, std::size_t>> joins; // (item, cluster)
+    for (std::size_t i = 0; i < items.size(); ++i) {
+      if (attached[i]) {
+        continue;
+      }
+      bool found         = false;
+      std::size_t best   = 0;
+      std::size_t target = 0;
+      for (const auto& [idx, c] : frontier) {
+        if (found && (hits[idx].getEnergy() < hits[best].getEnergy() ||
+                      (hits[idx].getEnergy() == hits[best].getEnergy() && idx > best))) {
+          continue;
+        }
+        for (std::size_t h : items[i]) {
+          if (is_neighbour(hits[h], hits[idx])) {
+            found  = true;
+            best   = idx;
+            target = c;
+            break;
+          }
+        }
+      }
+      if (found) {
+        joins.emplace_back(i, target);
+      }
+    }
+    frontier.clear();
+    for (const auto& [i, c] : joins) {
+      attached[i] = true;
+      for (std::size_t h : items[i]) {
+        clusters[c].push_back(h);
+        frontier.emplace_back(h, c);
+      }
+    }
+  }
+}
 
