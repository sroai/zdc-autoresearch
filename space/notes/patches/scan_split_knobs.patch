+
+void ImagingTopoCluster::split_group(const edm4eic::CalorimeterHitCollection& hits,
+                                     const std::list<std::size_t>& group,
+                                     std::vector<std::list<std::size_t>>& regions) const {
+  const std::vector<std::size_t> v(group.begin(), group.end());
+  const std::size_t n = v.size();
+  auto energy         = [&](std::size_t i) { return hits[v[i]].getEnergy(); };
+  // more energetic, ties broken by position in the group, so that the order is total
+  auto above = [&](std::size_t i, std::size_t j) {
+    return energy(i) > energy(j) || (energy(i) == energy(j) && i < j);
+  };
+  std::vector<std::vector<std::size_t>> nb(n);
+  for (std::size_t i = 0; i < n; ++i) {
+    for (std::size_t j = i + 1; j < n; ++j) {
+      if (is_neighbour(hits[v[i]], hits[v[j]])) {
+        nb[i].push_back(j);
+        nb[j].push_back(i);
+      }
+    }
+  }
+  // seeds: local maxima above the seed energy
+  std::vector<int> region(n, -1);
+  int nseed = 0;
+  for (std::size_t i = 0; i < n; ++i) {
+    if (energy(i) < splitSeedEdep) {
+      continue;
+    }
+    bool maximum = true;
+    for (std::size_t j : nb[i]) {
+      if (above(j, i)) {
+        maximum = false;
+        break;
+      }
+    }
+    if (maximum) {
+      region[i] = nseed++;
+    }
+  }
+  if (nseed <= 1) {
+    regions.push_back(group);
+    return;
+  }
+  // grow the regions in decreasing hit energy: a hit joins the region of its most energetic assigned neighbour;
+  // passes repeat for hits whose more energetic neighbours were not yet assigned
+  std::vector<std::size_t> order(n);
+  for (std::size_t i = 0; i < n; ++i) {
+    order[i] = i;
+  }
+  std::sort(order.begin(), order.end(), above);
+  bool progress = true;
+  while (progress) {
+    progress = false;
+    for (std::size_t i : order) {
+      if (region[i] >= 0) {
+        continue;
+      }
+      int best_j = -1;
+      for (std::size_t j : nb[i]) {
+        if (region[j] >= 0 && (best_j < 0 || above(j, static_cast<std::size_t>(best_j)))) {
+          best_j = static_cast<int>(j);
+        }
+      }
+      if (best_j >= 0) {
+        region[i] = region[best_j];
+        progress  = true;
+      }
+    }
+  }
+  for (std::size_t i = 0; i < n; ++i) {
+    // a hit no seed reaches (impossible in a connected group) stays with the first region
+    if (region[i] < 0) {
+      region[i] = 0;
+    }
+  }
+  // regions below splitMinRegionEdep merge, smallest first, into the neighbouring region that holds the most
+  // energetic hit adjacent to them
+  if (splitMinRegionEdep > 0.) {
+    std::vector<double> renergy(nseed, 0.);
+    for (std::size_t i = 0; i < n; ++i) {
+      renergy[region[i]] += energy(i);
+    }
+    std::vector<bool> alive(nseed, true);
+    int nalive = nseed;
+    while (nalive > 1) {
+      int small = -1;
+      for (int r = 0; r < nseed; ++r) {
+        if (alive[r] && renergy[r] < splitMinRegionEdep && (small < 0 || renergy[r] < renergy[small])) {
+          small = r;
+        }
+      }
+      if (small < 0) {
+        break;
+      }
+      int target  = -1;
+      double best = -1.;
+      for (std::size_t i = 0; i < n; ++i) {
+        if (region[i] != small) {
+          continue;
+        }
+        for (std::size_t j : nb[i]) {
+          if (region[j] != small && energy(j) > best) {
+            best   = energy(j);
+            target = region[j];
+          }
+        }
+      }
+      if (target < 0) {
+        break; // isolated (cannot happen in a connected group)
+      }
+      for (std::size_t i = 0; i < n; ++i) {
+        if (region[i] == small) {
+          region[i] = target;
+        }
+      }
+      renergy[target] += renergy[small];
+      renergy[small] = 0.;
+      alive[small]   = false;
+      --nalive;
+    }
+  }
+  std::vector<std::list<std::size_t>> out(nseed);
+  for (std::size_t i = 0; i < n; ++i) {
+    out[region[i]].push_back(v[i]);
+  }
+  for (auto& r : out) {
+    if (!r.empty()) {
+      regions.push_back(std::move(r));
     }
   }
 }
