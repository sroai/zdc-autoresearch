+    if (m_cfg.neutronPositionCentroid) {
+      // the energy-weighted centroid of the summed clusters: a fragmented shower is better placed than by its leader
+      double sx = 0.0;
+      double sy = 0.0;
+      double sz = 0.0;
+      for (std::size_t idx : kept) {
+        const auto& cl  = (*clusters)[idx];
+        const double E  = cl.getEnergy();
+        const auto& pos = cl.getPosition();
+        sx += E * pos.x;
+        sy += E * pos.y;
+        sz += E * pos.z;
+      }
+      n_pos = {static_cast<float>(sx / E_sum), static_cast<float>(sy / E_sum), static_cast<float>(sz / E_sum)};
+    }
   } else {
     return 0;
   }
@@ -309,6 +324,9 @@ std::pair<int, int> FarForwardNeutralsReconstruction::chooseLambdaPhotonPair(
       double raw   = 0.0;
       double Elead = -1.0;
       int lead     = -1;
+      double cx    = 0.0;
+      double cy    = 0.0;
+      double cz    = 0.0;
       for (std::size_t k = 0; k < clusters.size(); ++k) {
         if (k == cand[ia] || k == cand[ib]) {
           continue;
@@ -318,6 +336,10 @@ std::pair<int, int> FarForwardNeutralsReconstruction::chooseLambdaPhotonPair(
           continue;
         }
         raw += E;
+        const auto& pk = clusters[k].getPosition();
+        cx += E * pk.x;
+        cy += E * pk.y;
+        cz += E * pk.z;
         if (E > Elead) {
           Elead = E;
           lead  = static_cast<int>(k);
@@ -331,7 +353,10 @@ std::pair<int, int> FarForwardNeutralsReconstruction::chooseLambdaPhotonPair(
         continue;
       }
       const double pn = std::sqrt(En * En - m_n * m_n);
-      const V3 xn     = toProton(clusters[lead].getPosition());
+      const V3 xn     = m_cfg.neutronPositionCentroid
+                                ? toProton(edm4hep::Vector3f{static_cast<float>(cx / raw), static_cast<float>(cy / raw),
+                                                             static_cast<float>(cz / raw)})
+                                : toProton(clusters[lead].getPosition());
       const V3 x1     = toProton(c1.getPosition());
       const V3 x2     = toProton(c2.getPosition());
       // decay vertex: depth by bisection on the opening angle along the momentum-weighted slope (pi0 constraint)
