index b8318b81..9b441486 100644
--- a/src/algorithms/calorimetry/ImagingTopoCluster.cc
+++ b/src/algorithms/calorimetry/ImagingTopoCluster.cc
@@ -333,7 +333,7 @@ void ImagingTopoCluster::core_split_group(const edm4eic::CalorimeterHitCollectio
       kept.push_back(c);
     }
   }
-  if (kept.empty() || (kept.size() == 1 && deep.empty())) {
+  if (kept.empty() || (kept.size() == 1 && deep.empty() && m_cfg.coreSplitCoreMaxLayer <= 0)) {
     regions.push_back(group);
     return;
   }
@@ -371,7 +371,23 @@ void ImagingTopoCluster::core_split_group(const edm4eic::CalorimeterHitCollectio
       }
     }
   }
-  std::vector<std::list<std::size_t>> out(nreg);
+  int nout = nreg;
+  if (m_cfg.coreSplitCoreMaxLayer > 0) {
+    // a core region keeps only its hits up to coreSplitCoreMaxLayer (a photon deposits early); deeper hits join the
+    // deep region, created here when the group has no deeper maximum
+    const int deep_id = static_cast<int>(kept.size());
+    for (std::size_t i = 0; i < n; ++i) {
+      const int r = region[i];
+      if (r < 0 || r >= deep_id) {
+        continue;
+      }
+      if (hits[v[i]].getLayer() > m_cfg.coreSplitCoreMaxLayer) {
+        region[i] = deep_id;
+        nout      = deep_id + 1;
+      }
+    }
+  }
+  std::vector<std::list<std::size_t>> out(nout);
   for (std::size_t i = 0; i < n; ++i) {
     // a hit no seed reaches (impossible in a connected group) stays with the first region
     out[region[i] >= 0 ? region[i] : 0].push_back(v[i]);
