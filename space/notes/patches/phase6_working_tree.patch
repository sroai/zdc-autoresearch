+std::vector<FarForwardNeutralsReconstruction::CrystalPhoton>
+FarForwardNeutralsReconstruction::crystalCandidates(const edm4eic::ClusterCollection& crystalClusters,
+                                                    const edm4eic::ClusterCollection& clusters,
+                                                    const std::vector<std::size_t>& cand,
+                                                    const edm4eic::CalorimeterHitCollection* hcalHits,
+                                                    std::vector<AltEnergy>* alts,
+                                                    const edm4eic::CalorimeterHitCollection* crystalHits) const {
+  using V3        = std::array<double, 3>;
+  const double ca = std::cos(-m_cfg.globalToProtonRotation);
+  const double sa = std::sin(-m_cfg.globalToProtonRotation);
+  auto toProton   = [&](const edm4hep::Vector3f& p) -> V3 {
+    return {p.x * ca + p.z * sa, p.y, -p.x * sa + p.z * ca};
+  };
+
+  // The Hcal hits of the event, each once: the rec hits when given (the photon law was fitted on them), else the
+  // clusters' hits (island clusters that split at local maxima share hits).
+  std::vector<std::pair<V3, edm4eic::CalorimeterHit>> hits;
+  if (hcalHits != nullptr) {
+    for (const auto& hit : *hcalHits) {
+      hits.emplace_back(toProton(hit.getPosition()), hit);
+    }
+  } else {
+    std::set<std::pair<std::uint32_t, int>> seen;
+    for (const auto& cl : clusters) {
+      for (const auto& hit : cl.getHits()) {
+        const auto id = hit.getObjectID();
+        if (seen.insert({id.collectionID, id.index}).second) {
+          hits.emplace_back(toProton(hit.getPosition()), hit);
+        }
+      }
+    }
+  }
+
+  std::vector<CrystalPhoton> out;
+  for (std::size_t k = 0; k < crystalClusters.size(); ++k) {
+    const auto& cc      = crystalClusters[k];
+    const double e_crys = cc.getEnergy();
+    if (e_crys < m_cfg.crystalClusterEmin) {
+      continue;
+    }
+    const V3 xc = toProton(cc.getPosition());
+    if (xc[2] <= 0.0) {
+      continue;
+    }
+    CrystalPhoton cp{k, 0.0, cc.getPosition(), 0.0, {0, 0, 0}, {}};
+    // tagged Hcal clusters behind it: the cluster position projected from the IP to the crystal depth
+    for (std::size_t i : cand) {
+      const V3 xh = toProton(clusters[i].getPosition());
+      if (xh[2] <= 0.0) {
+        continue;
+      }
+      const double s = xc[2] / xh[2];
+      if (std::hypot(xh[0] * s - xc[0], xh[1] * s - xc[1]) <= m_cfg.crystalVetoRadius) {
+        cp.behind.push_back(i);
+      }
+    }
+    // the Hcal column: hits within crystalColumnRadius of the line from the IP through the crystal cluster
+    double sx = 0.0;
+    double sy = 0.0;
+    double sz = 0.0;
+    for (const auto& [xh, hit] : hits) {
+      const double s = xh[2] / xc[2];
+      if (std::hypot(xh[0] - xc[0] * s, xh[1] - xc[1] * s) <= m_cfg.crystalColumnRadius) {
+        const double e  = hit.getEnergy();
+        const auto& pos = hit.getPosition();
+        cp.column_energy += e;
+        sx += e * pos.x;
+        sy += e * pos.y;
+        sz += e * pos.z;
+      }
+    }
+    if (cp.column_energy > 0.0) {
+      cp.column_position = {static_cast<float>(sx / cp.column_energy), static_cast<float>(sy / cp.column_energy),
+                            static_cast<float>(sz / cp.column_energy)};
+    }
+    // the photon carries at least its crystal energy (the crystals clip at 2 GeV each, so that is a lower bound)
+    const auto& law = m_cfg.crystalGammaLaw;
+    cp.energy       = std::max(e_crys, law.at(0) * e_crys + law.at(1) * cp.column_energy + law.at(2));
+    out.push_back(std::move(cp));
+  }
+
+  // The veto: a crystal cluster with a tagged Hcal cluster behind it is that photon already, unless (crystalVetoSplit)
+  // two or more candidates sit in front of the same tagged cluster (two photons sharing one Hcal cluster).
+  std::vector<int> in_front(clusters.size(), 0);
+  for (const auto& cp : out) {
+    for (std::size_t i : cp.behind) {
+      ++in_front[i];
+    }
+  }
+  // crystalEnergyAlternative: each tagged Hcal cluster with a crystal cluster in front takes the leading one's energy
+  if (alts != nullptr && m_cfg.crystalEnergyAlternative) {
+    for (std::size_t i : cand) {
+      const CrystalPhoton* lead = nullptr;
+      for (const auto& cp : out) {
+        if (std::ranges::find(cp.behind, i) != cp.behind.end() &&
+            (lead == nullptr || crystalClusters[cp.index].getEnergy() > crystalClusters[lead->index].getEnergy())) {
+          lead = &cp;
+        }
+      }
+      if (lead != nullptr) {
+        const double out_e = m_cfg.crystalAltColumnOut
+                                 ? std::max(0.0, m_cfg.crystalColumnNeutronScale * lead->column_energy - clusters[i].getEnergy())
+                                 : 0.0;
+        alts->push_back({i, lead->energy, lead->index, out_e, lead->column_position});
+      }
+    }
+  }
+  // hcalAxisAlternative: each tagged Hcal cluster also offers the axis law's energy (crystal and Hcal rec hits within
+  // hcalAxisRadius of the line from the IP through it)
+  if (alts != nullptr && m_cfg.hcalAxisAlternative && crystalHits != nullptr && hcalHits != nullptr) {
+    const auto& law = m_cfg.hcalAxisLaw;
+    for (std::size_t i : cand) {
+      const V3 xh = toProton(clusters[i].getPosition());
+      if (xh[2] <= 0.0) {
+        continue;
+      }
+      const double tx = xh[0] / xh[2];
+      const double ty = xh[1] / xh[2];
+      double e_crys   = 0.0;
+      for (const auto& hit : *crystalHits) {
+        const V3 x = toProton(hit.getPosition());
+        if (std::hypot(x[0] - tx * x[2], x[1] - ty * x[2]) <= m_cfg.hcalAxisRadius) {
+          e_crys += hit.getEnergy();
+        }
+      }
+      double e_col = 0.0;
+      double sx    = 0.0;
+      double sy    = 0.0;
+      double sz    = 0.0;
+      for (const auto& [x, hit] : hits) {
+        if (std::hypot(x[0] - tx * x[2], x[1] - ty * x[2]) <= m_cfg.hcalAxisRadius) {
+          const double e  = hit.getEnergy();
+          const auto& pos = hit.getPosition();
+          e_col += e;
+          sx += e * pos.x;
+          sy += e * pos.y;
+          sz += e * pos.z;
+        }
+      }
+      const double e_ax = law.at(0) * e_crys + law.at(1) * e_col + law.at(2);
+      if (e_ax <= 0.0) {
+        continue;
+      }
+      const double out_e = m_cfg.crystalAltColumnOut
+                               ? std::max(0.0, m_cfg.crystalColumnNeutronScale * e_col - clusters[i].getEnergy())
+                               : 0.0;
+      const edm4hep::Vector3f centroid =
+          e_col > 0.0 ? edm4hep::Vector3f{static_cast<float>(sx / e_col), static_cast<float>(sy / e_col),
+                                          static_cast<float>(sz / e_col)}
+                      : clusters[i].getPosition();
+      alts->push_back({i, e_ax, kNoCrystal, out_e, centroid});
+    }
+  }
+  std::erase_if(out, [&](const CrystalPhoton& cp) {
+    if (cp.behind.empty()) {
+      return false;
+    }
+    if (m_cfg.crystalVetoSplit) {
+      return std::ranges::none_of(cp.behind, [&](std::size_t i) { return in_front[i] >= 2; });
+    }
+    return true;
+  });
+  return out;
+}
+
+double FarForwardNeutralsReconstruction::isolationTerm(const edm4eic::ClusterCollection& clusters,
+                                                       const edm4hep::Vector3f& pos, bool crystal) const {
+  if (m_cfg.lambdaPairingIsolationWeight == 0.0 || clusters.empty()) {
+    return 0.0;
+  }
+  std::size_t lead = 0;
+  for (std::size_t k = 1; k < clusters.size(); ++k) {
+    if (clusters[k].getEnergy() > clusters[lead].getEnergy()) {
+      lead = k;
+    }
+  }
+  const double ca = std::cos(-m_cfg.globalToProtonRotation);
+  const double sa = std::sin(-m_cfg.globalToProtonRotation);
+  auto toProton   = [&](const edm4hep::Vector3f& p) -> std::array<double, 3> {
+    return {p.x * ca + p.z * sa, p.y, -p.x * sa + p.z * ca};
+  };
+  const auto xl = toProton(clusters[lead].getPosition());
+  auto x        = toProton(pos);
+  if (crystal && x[2] > 0.0) {
+    const double f = xl[2] / x[2];
+    x[0] *= f;
+    x[1] *= f;
+  }
+  const double d = std::hypot(x[0] - xl[0], x[1] - xl[1]);
+  return m_cfg.lambdaPairingIsolationWeight * std::exp(-d / m_cfg.lambdaPairingIsolationLength);
+}
+
+FarForwardNeutralsReconstruction::CrystalChoice FarForwardNeutralsReconstruction::chooseCrystalHypothesis(
+    const edm4eic::ClusterCollection& clusters, const std::vector<std::size_t>& cand,
+    const std::vector<CrystalPhoton>& crystals, const std::vector<AltEnergy>& alts,
+    const std::vector<double>& gammaScaleCoeff,
+    const std::vector<double>& neutronScaleCoeff, const CorrFunc& gammaCorr, const CorrFunc& neutronCorr,
+    double clusterEmin, const std::vector<ExternalPhoton>* external) const {
+  const double m_n      = m_particleSvc.particle(2112).mass;
+  const double m_pi0    = m_particleSvc.particle(111).mass;
+  const double m_lambda = m_particleSvc.particle(3122).mass;
+
+  using V3        = std::array<double, 3>;
+  const double ca = std::cos(-m_cfg.globalToProtonRotation);
+  const double sa = std::sin(-m_cfg.globalToProtonRotation);
+  auto toProton   = [&](const edm4hep::Vector3f& p) -> V3 {
+    return {p.x * ca + p.z * sa, p.y, -p.x * sa + p.z * ca};
+  };
+  auto sub  = [](const V3& a, const V3& b) { return V3{a[0] - b[0], a[1] - b[1], a[2] - b[2]}; };
+  auto norm = [](const V3& a) { return std::sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]); };
+  auto unit = [&](const V3& a) {
+    const double n = norm(a);
+    return V3{a[0] / n, a[1] / n, a[2] / n};
+  };
+  auto angle = [&](const V3& a, const V3& b) {
+    const V3 ua = unit(a);
+    const V3 ub = unit(b);
+    return std::acos(std::clamp(ua[0] * ub[0] + ua[1] * ub[1] + ua[2] * ub[2], -1.0, 1.0));
+  };
+
+  // The Hcal energy above clusterEmin and its moment (lab frame): a hypothesis's neutron is this minus its Hcal photon
+  // and minus the columns behind its crystal photons.
+  double tot = 0.0;
+  std::array<double, 3> moment{0.0, 0.0, 0.0};
+  for (const auto& cl : clusters) {
+    const double e = cl.getEnergy();
+    if (e < clusterEmin) {
+      continue;
+    }
+    tot += e;
+    moment[0] += e * cl.getPosition().x;
+    moment[1] += e * cl.getPosition().y;
+    moment[2] += e * cl.getPosition().z;
+  }
+  // the neutron energy and proton-frame position after removing an Hcal photon (or -1) and crystal photons' columns
+  auto neutron = [&](std::initializer_list<int> hcals, std::initializer_list<const CrystalPhoton*> crys,
+                     std::initializer_list<const AltEnergy*> alt_out = {}) -> std::pair<double, V3> {
+    double raw = tot;
+    std::array<double, 3> m = moment;
+    for (const auto* a : alt_out) {
+      if (a == nullptr || a->column_out <= 0.0) {
+        continue;
+      }
+      raw -= a->column_out;
+      m[0] -= a->column_out * a->column_position.x;
+      m[1] -= a->column_out * a->column_position.y;
+      m[2] -= a->column_out * a->column_position.z;
+    }
+    for (int hcal : hcals) {
+      if (hcal < 0 || clusters[hcal].getEnergy() < clusterEmin) {
+        continue;
+      }
+      const double e = clusters[hcal].getEnergy();
+      raw -= e;
+      m[0] -= e * clusters[hcal].getPosition().x;
+      m[1] -= e * clusters[hcal].getPosition().y;
+      m[2] -= e * clusters[hcal].getPosition().z;
+    }
+    for (const auto* c : crys) {
+      const double e_out = m_cfg.crystalColumnNeutronScale * c->column_energy;
+      raw -= e_out;
+      m[0] -= e_out * c->column_position.x;
+      m[1] -= e_out * c->column_position.y;
+      m[2] -= e_out * c->column_position.z;
+    }
+    if (raw <= 0.0) {
+      return {0.0, V3{0, 0, 0}};
+    }
+    const V3 xn = toProton(edm4hep::Vector3f{static_cast<float>(m[0] / raw), static_cast<float>(m[1] / raw),
+                                             static_cast<float>(m[2] / raw)});
+    return {neutronCorr(raw, neutronScaleCoeff), xn};
+  };
+
+  // The fitted masses and the decay-depth term of photons (E1, x1), (E2, x2) with the neutron (En, xn). The vertex
+  // slope is momentum-weighted when every impact point is in the ZDC (as the ZDC pairs), or taken with each daughter's
+  // lever arm when one photon is in the B0 ECal (as the mixed hypotheses). Returns +inf when it cannot be fitted.
+  auto fit = [&](double E1, const V3& x1, double E2, const V3& x2, double En, const V3& xn, bool lever_arm) {
+    if (En <= m_n || E1 <= 0.0 || E2 <= 0.0) {
+      return std::numeric_limits<double>::infinity();
+    }
+    const double pn     = std::sqrt(En * En - m_n * m_n);
+    const double th_exp = 2 * std::asin(std::min(1.0, m_pi0 / (2 * std::sqrt(E1 * E2))));
+    const std::array<std::pair<double, const V3*>, 3> impacts{{{pn, &xn}, {E1, &x1}, {E2, &x2}}};
+    const double p_sum   = pn + E1 + E2;
+    const double z_first = std::min({xn[2], x1[2], x2[2]});
+    auto slope_at        = [&](double z) {
+      if (!lever_arm) {
+        const double wz = pn * xn[2] + E1 * x1[2] + E2 * x2[2];
+        return V3{(pn * xn[0] + E1 * x1[0] + E2 * x2[0]) / wz, (pn * xn[1] + E1 * x1[1] + E2 * x2[1]) / wz, 1.0};
+      }
+      double sx = 0.0;
+      double sy = 0.0;
+      double sw = 0.0;
+      for (const auto& [p, x] : impacts) {
+        const double w = p / ((*x)[2] - z);
+        sx += w * (*x)[0];
+        sy += w * (*x)[1];
+        sw += w;
+      }
+      const double den = p_sum + z * sw;
+      return V3{sx / den, sy / den, 1.0};
+    };
+    if (z_first <= 0.0) {
+      return std::numeric_limits<double>::infinity();
+    }
+    double z_near = 0.0;
+    double z_far  = lever_arm ? std::min(m_zZDC, 0.999 * z_first) : m_zZDC;
+    for (int it = 0; it < m_cfg.lambdaPairingIterations; ++it) {
+      const double z = 0.5 * (z_near + z_far);
+      const V3 s     = slope_at(z);
+      const V3 v{s[0] * z, s[1] * z, z};
+      if (angle(sub(x1, v), sub(x2, v)) > th_exp) {
+        z_far = z;
+      } else {
+        z_near = z;
+      }
+    }
+    const V3 s = slope_at(z_near);
+    const V3 v{s[0] * z_near, s[1] * z_near, z_near};
+    const V3 un = unit(sub(xn, v));
+    const V3 u1 = unit(sub(x1, v));
+    const V3 u2 = unit(sub(x2, v));
+    V3 pg{};
+    V3 pl{};
+    for (int q = 0; q < 3; ++q) {
+      pg[q] = E1 * u1[q] + E2 * u2[q];
+      pl[q] = pg[q] + pn * un[q];
+    }
+    const double Eg       = E1 + E2;
+    const double El       = En + E1 + E2;
+    const double mpi      = std::sqrt(std::max(0.0, Eg * Eg - (pg[0] * pg[0] + pg[1] * pg[1] + pg[2] * pg[2])));
+    const double p_lambda = norm(pl);
+    const double ml       = std::sqrt(std::max(0.0, El * El - p_lambda * p_lambda));
+    const double tpi      = (mpi - m_pi0) / (m_cfg.lambdaPairingPi0Window * m_pi0);
+    const double tl       = (ml - m_lambda) / m_cfg.lambdaPairingLambdaSigma;
+    const double L        = std::max(p_lambda / m_lambda * m_cfg.lambdaCTau, 1.0);
+    const double depth    = z_near / L + std::log(L * std::max(1.0 - std::exp(-m_zZDC / L), 1e-12));
+    return tpi * tpi + tl * tl + m_cfg.lambdaPairingDepthWeight * depth;
+  };
+
+  // the energies a tagged Hcal photon may carry: the Hcal law's, and the crystal law's when a crystal cluster is in front
+  auto options = [&](std::size_t i) {
+    std::vector<std::pair<double, const AltEnergy*>> o{{gammaCorr(clusters[i].getEnergy(), gammaScaleCoeff), nullptr}};
+    for (const auto& a : alts) {
+      if (a.hcal == i) {
+        o.emplace_back(a.energy, &a);
+      }
+    }
+    return o;
+  };
+
+  // the crystal cluster an alternative energy links (-1: none, the Hcal axis law)
+  auto crysIndex = [](const AltEnergy* a) {
+    return (a == nullptr || a->crystal == kNoCrystal) ? -1 : static_cast<int>(a->crystal);
+  };
+
+  // the isolation term of a crystal photon (lambdaPairingIsolationCrystal)
+  auto iso_crystal = [&](const CrystalPhoton& c) {
+    return m_cfg.lambdaPairingIsolationCrystal ? isolationTerm(clusters, c.position, true) : 0.0;
+  };
+
+  CrystalChoice best;
+  const double wpd = m_cfg.lambdaPairingPhotonDepthWeight;
+  for (std::size_t ka = 0; ka < crystals.size(); ++ka) {
+    const auto& c1 = crystals[ka];
+    const V3 x1    = toProton(c1.position);
+    // crystal + tagged Hcal photon (never the Hcal cluster behind the crystal: the same photon)
+    for (std::size_t i : cand) {
+      if (std::ranges::find(c1.behind, i) != c1.behind.end()) {
+        continue;
+      }
+      const V3 x2 = toProton(clusters[i].getPosition());
+      for (const auto& [e2, alt] : options(i)) {
+        const auto [En, xn] = neutron({static_cast<int>(i)}, {&c1}, {alt});
+        const double score  = fit(c1.energy, x1, e2, x2, En, xn, false) +
+                             wpd * ((x2[2] - m_zZDC) / 100.0 + m_cfg.crystalPhotonDepth) +
+                             isolationTerm(clusters, clusters[i].getPosition(), false) + iso_crystal(c1);
+        if (score < best.score) {
+          best = {score, static_cast<int>(ka), -1, static_cast<int>(i), -1};
+          if (alt != nullptr) {
+            best.e_hcal    = alt->energy;
+            best.crys_hcal = crysIndex(alt);
+          }
+        }
+      }
+    }
+    // crystal + crystal
+    for (std::size_t kb = ka + 1; kb < crystals.size(); ++kb) {
+      const auto& c2      = crystals[kb];
+      const auto [En, xn] = neutron({}, {&c1, &c2});
+      const double score  = fit(c1.energy, x1, c2.energy, toProton(c2.position), En, xn, false) +
+                           wpd * 2 * m_cfg.crystalPhotonDepth + iso_crystal(c1) + iso_crystal(c2);
+      if (score < best.score) {
+        best = {score, static_cast<int>(ka), static_cast<int>(kb), -1, -1};
+      }
+    }
+    // crystal + external (B0 ECal) photon
+    if (external != nullptr) {
+      const auto [En, xn] = neutron({}, {&c1});
+      for (std::size_t ke = 0; ke < external->size(); ++ke) {
+        const auto& ext    = (*external)[ke];
+        const double score = fit(c1.energy, x1, ext.energy, toProton(ext.position), En, xn, true) +
+                             wpd * m_cfg.lambdaPairingMixedPhotonDepthFactor * m_cfg.crystalPhotonDepth +
+                             iso_crystal(c1);
+        if (score < best.score) {
+          best = {score, static_cast<int>(ka), -1, -1, static_cast<int>(ke)};
+        }
+      }
+    }
+  }
+  if (alts.empty()) {
+    return best;
+  }
+  // Hcal pairs with at least one crystal-law energy (the pairs with Hcal-law energies only are chooseLambdaPhotonPair's);
+  // two photons never take the same crystal cluster
+  for (std::size_t ia = 0; ia < cand.size(); ++ia) {
+    for (std::size_t ib = ia + 1; ib < cand.size(); ++ib) {
+      const std::size_t i = cand[ia];
+      const std::size_t j = cand[ib];
+      const auto oi       = options(i);
+      const auto oj       = options(j);
+      if (oi.size() == 1 && oj.size() == 1) {
+        continue;
+      }
+      const V3 x1 = toProton(clusters[i].getPosition());
+      const V3 x2 = toProton(clusters[j].getPosition());
+      for (const auto& [e1, a1] : oi) {
+        for (const auto& [e2, a2] : oj) {
+          if ((a1 == nullptr && a2 == nullptr) ||
+              (a1 != nullptr && a2 != nullptr && a1->crystal != kNoCrystal && a1->crystal == a2->crystal)) {
+            continue;
+          }
+          const auto [En, xn] = neutron({static_cast<int>(i), static_cast<int>(j)}, {}, {a1, a2});
+          const double score =
+              fit(e1, x1, e2, x2, En, xn, false) + wpd * (x1[2] + x2[2] - 2 * m_zZDC) / 100.0 +
+              isolationTerm(clusters, clusters[i].getPosition(), false) +
+              isolationTerm(clusters, clusters[j].getPosition(), false);
+          if (score < best.score) {
+            best = {score, -1, -1, static_cast<int>(i), -1, static_cast<int>(j), a1 ? a1->energy : -1.0,
+                    a2 ? a2->energy : -1.0, crysIndex(a1), crysIndex(a2)};
+          }
+        }
+      }
+    }
+  }
+  if (external != nullptr) {
+    for (const auto& a : alts) {
+      const auto [En, xn] = neutron({static_cast<int>(a.hcal)}, {}, {&a});
+      const V3 x1         = toProton(clusters[a.hcal].getPosition());
+      for (std::size_t ke = 0; ke < external->size(); ++ke) {
+        const auto& ext    = (*external)[ke];
+        const double score = fit(a.energy, x1, ext.energy, toProton(ext.position), En, xn, true) +
+                             wpd * m_cfg.lambdaPairingMixedPhotonDepthFactor * (x1[2] - m_zZDC) / 100.0 +
+                             isolationTerm(clusters, clusters[a.hcal].getPosition(), false);
+        if (score < best.score) {
+          best = {score, -1, -1, static_cast<int>(a.hcal), static_cast<int>(ke), -1, a.energy, -1.0, crysIndex(&a), -1};
+        }
+      }
+    }
+  }
   return best;
 }
 
