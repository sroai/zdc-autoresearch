+  // least coreSplitSeedEdep seeds one shared region. Hits join the region of their most energetic neighbour, in
+  // decreasing hit energy. A group without a core, or with one core and no deeper maximum, is kept whole.
+  double coreSplitSeedEdep  = 0.;
+  int coreSplitMaxLayer     = 8;
+  double coreSplitMinDistXY = 50. * dd4hep::mm;
 };
 
