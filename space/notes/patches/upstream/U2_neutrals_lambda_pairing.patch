+std::pair<int, int> FarForwardNeutralsReconstruction::chooseLambdaPhotonPair(
+    const edm4eic::ClusterCollection& clusters, const std::vector<std::size_t>& cand,
+    const std::vector<double>& gammaScaleCoeff, const std::vector<double>& neutronScaleCoeff,
+    const CorrFunc& gammaCorr, const CorrFunc& neutronCorr, double clusterEmin) const {
+  const double m_n      = m_particleSvc.particle(2112).mass;
+  const double m_pi0    = m_particleSvc.particle(111).mass;
+  const double m_lambda = m_particleSvc.particle(3122).mass;
+
+  using V3 = std::array<double, 3>;
+  // positions in the proton frame, as LambdaReconstruction (RotateY(-globalToProtonRotation)), in mm
+  const double ca = std::cos(-m_cfg.globalToProtonRotation);
+  const double sa = std::sin(-m_cfg.globalToProtonRotation);
+  auto toProton   = [&](const edm4hep::Vector3f& p) -> V3 {
+    return {p.x * ca + p.z * sa, p.y, -p.x * sa + p.z * ca};
+  };
+  auto sub  = [](const V3& a, const V3& b) { return V3{a[0] - b[0], a[1] - b[1], a[2] - b[2]}; };
+  auto norm = [](const V3& a) { return std::sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]); };
+  auto unit = [&](const V3& a) {
+    const double n = norm(a);
+    return V3{a[0] / n, a[1] / n, a[2] / n};
+  };
+  auto angle = [&](const V3& a, const V3& b) {
+    const V3 ua = unit(a);
+    const V3 ub = unit(b);
+    return std::acos(std::clamp(ua[0] * ub[0] + ua[1] * ub[1] + ua[2] * ub[2], -1.0, 1.0));
+  };
+
+  std::pair<int, int> best{-1, -1};
+  double best_score = std::numeric_limits<double>::infinity();
+  for (std::size_t ia = 0; ia < cand.size(); ++ia) {
+    for (std::size_t ib = ia + 1; ib < cand.size(); ++ib) {
+      const auto& c1  = clusters[cand[ia]];
+      const auto& c2  = clusters[cand[ib]];
+      const double E1 = gammaCorr(c1.getEnergy(), gammaScaleCoeff);
+      const double E2 = gammaCorr(c2.getEnergy(), gammaScaleCoeff);
+      if (E1 <= 0.0 || E2 <= 0.0) {
+        continue;
+      }
+      // the neutron of this hypothesis: every other cluster above clusterEmin, at its leader
+      double raw   = 0.0;
+      double Elead = -1.0;
+      int lead     = -1;
+      double cx    = 0.0;
+      double cy    = 0.0;
+      double cz    = 0.0;
+      for (std::size_t k = 0; k < clusters.size(); ++k) {
+        if (k == cand[ia] || k == cand[ib]) {
+          continue;
+        }
+        const double E = clusters[k].getEnergy();
+        if (E < clusterEmin) {
+          continue;
+        }
+        raw += E;
+        const auto& pk = clusters[k].getPosition();
+        cx += E * pk.x;
+        cy += E * pk.y;
+        cz += E * pk.z;
+        if (E > Elead) {
+          Elead = E;
+          lead  = static_cast<int>(k);
+        }
+      }
+      if (lead < 0 || raw <= 0.0) {
+        continue;
+      }
+      const double En = neutronCorr(raw, neutronScaleCoeff);
+      if (En <= m_n) {
+        continue;
+      }
+      const double pn = std::sqrt(En * En - m_n * m_n);
+      const V3 xn     = m_cfg.neutronPositionCentroid
+                                ? toProton(edm4hep::Vector3f{static_cast<float>(cx / raw), static_cast<float>(cy / raw),
+                                                             static_cast<float>(cz / raw)})
+                                : toProton(clusters[lead].getPosition());
+      const V3 x1     = toProton(c1.getPosition());
+      const V3 x2     = toProton(c2.getPosition());
+      // decay vertex: depth by bisection on the opening angle along the momentum-weighted slope (pi0 constraint)
+      const double wz = pn * xn[2] + E1 * x1[2] + E2 * x2[2];
+      if (wz <= 0.0) {
+        continue;
+      }
+      const double tx     = (pn * xn[0] + E1 * x1[0] + E2 * x2[0]) / wz;
+      const double ty     = (pn * xn[1] + E1 * x1[1] + E2 * x2[1]) / wz;
+      const double th_exp = 2 * std::asin(std::min(1.0, m_pi0 / (2 * std::sqrt(E1 * E2))));
+      double z_near       = 0.0;
+      double z_far        = m_zZDC;
+      for (int it = 0; it < m_cfg.lambdaPairingIterations; ++it) {
+        const double z = 0.5 * (z_near + z_far);
+        const V3 v{tx * z, ty * z, z};
+        if (angle(sub(x1, v), sub(x2, v)) > th_exp) {
+          z_far = z;
+        } else {
+          z_near = z;
+        }
+      }
+      const V3 v{tx * z_near, ty * z_near, z_near};
+      const V3 un = unit(sub(xn, v));
+      const V3 u1 = unit(sub(x1, v));
+      const V3 u2 = unit(sub(x2, v));
+      V3 pg{};
+      V3 pl{};
+      for (int q = 0; q < 3; ++q) {
+        pg[q] = E1 * u1[q] + E2 * u2[q];
+        pl[q] = pg[q] + pn * un[q];
+      }
+      const double Eg       = E1 + E2;
+      const double El       = En + E1 + E2;
+      const double mpi      = std::sqrt(std::max(0.0, Eg * Eg - (pg[0] * pg[0] + pg[1] * pg[1] + pg[2] * pg[2])));
+      const double p_lambda = norm(pl);
+      const double ml       = std::sqrt(std::max(0.0, El * El - p_lambda * p_lambda));
+      const double tpi      = (mpi - m_pi0) / (m_cfg.lambdaPairingPi0Window * m_pi0);
+      const double tl       = (ml - m_lambda) / m_cfg.lambdaPairingLambdaSigma;
+      // the decay-depth density of a Lambda of this momentum, exp(-z/L)/L on [0, zZDC], L = (p/m) c tau
+      const double L     = std::max(p_lambda / m_lambda * m_cfg.lambdaCTau, 1.0);
+      const double depth = z_near / L + std::log(L * std::max(1.0 - std::exp(-m_zZDC / L), 1e-12));
+      // the photons' depth in the ZDC (x1, x2 are proton-frame positions; a constant offset does not change the ranking)
+      const double photon_depth = (x1[2] + x2[2] - 2 * m_zZDC) / 100.0;
+      const double score        = tpi * tpi + tl * tl + m_cfg.lambdaPairingDepthWeight * depth +
+                           m_cfg.lambdaPairingPhotonDepthWeight * photon_depth;
+      if (score < best_score) {
+        best_score = score;
+        best       = {static_cast<int>(cand[ia]), static_cast<int>(cand[ib])};
+      }
+    }
+  }
+  return best;
+}
