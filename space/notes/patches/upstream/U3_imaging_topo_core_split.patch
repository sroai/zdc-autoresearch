+void ImagingTopoCluster::core_split_group(const edm4eic::CalorimeterHitCollection& hits,
+                                          const std::list<std::size_t>& group,
+                                          std::vector<std::list<std::size_t>>& regions) const {
+  const std::vector<std::size_t> v(group.begin(), group.end());
+  const std::size_t n = v.size();
+  auto energy         = [&](std::size_t i) { return hits[v[i]].getEnergy(); };
+  // more energetic, ties broken by position in the group, so that the order is total
+  auto above = [&](std::size_t i, std::size_t j) {
+    return energy(i) > energy(j) || (energy(i) == energy(j) && i < j);
+  };
+  std::vector<std::vector<std::size_t>> nb(n);
+  for (std::size_t i = 0; i < n; ++i) {
+    for (std::size_t j = i + 1; j < n; ++j) {
+      if (is_neighbour(hits[v[i]], hits[v[j]])) {
+        nb[i].push_back(j);
+        nb[j].push_back(i);
+      }
+    }
+  }
+  // local maxima above the seed energy: shallow ones are core candidates, deeper ones seed the shared region
+  std::vector<std::size_t> cores;
+  std::vector<std::size_t> deep;
+  for (std::size_t i = 0; i < n; ++i) {
+    if (energy(i) < coreSplitSeedEdep) {
+      continue;
+    }
+    bool maximum = true;
+    for (std::size_t j : nb[i]) {
+      if (above(j, i)) {
+        maximum = false;
+        break;
+      }
+    }
+    if (!maximum) {
+      continue;
+    }
+    (hits[v[i]].getLayer() <= m_cfg.coreSplitMaxLayer ? cores : deep).push_back(i);
+  }
+  // one core per transverse neighbourhood: the most energetic wins
+  std::sort(cores.begin(), cores.end(), above);
+  std::vector<std::size_t> kept;
+  for (std::size_t c : cores) {
+    bool isolated = true;
+    for (std::size_t k : kept) {
+      const auto& pc = hits[v[c]].getPosition();
+      const auto& pk = hits[v[k]].getPosition();
+      if (std::hypot(pc.x - pk.x, pc.y - pk.y) <= coreSplitMinDistXY) {
+        isolated = false;
+        break;
+      }
+    }
+    if (isolated) {
+      kept.push_back(c);
+    }
+  }
+  if (kept.empty() || (kept.size() == 1 && deep.empty() && m_cfg.coreSplitCoreMaxLayer <= 0)) {
+    regions.push_back(group);
+    return;
+  }
+  const int nreg = static_cast<int>(kept.size()) + (deep.empty() ? 0 : 1);
+  std::vector<int> region(n, -1);
+  for (std::size_t k = 0; k < kept.size(); ++k) {
+    region[kept[k]] = static_cast<int>(k);
+  }
+  for (std::size_t d : deep) {
+    region[d] = static_cast<int>(kept.size());
+  }
+  // grow the regions in decreasing hit energy: a hit joins the region of its most energetic assigned neighbour;
+  // passes repeat for hits whose more energetic neighbours were not yet assigned
+  std::vector<std::size_t> order(n);
+  for (std::size_t i = 0; i < n; ++i) {
+    order[i] = i;
+  }
+  std::sort(order.begin(), order.end(), above);
+  bool progress = true;
+  while (progress) {
+    progress = false;
+    for (std::size_t i : order) {
+      if (region[i] >= 0) {
+        continue;
+      }
+      int best_j = -1;
+      for (std::size_t j : nb[i]) {
+        if (region[j] >= 0 && (best_j < 0 || above(j, static_cast<std::size_t>(best_j)))) {
+          best_j = static_cast<int>(j);
+        }
+      }
+      if (best_j >= 0) {
+        region[i] = region[best_j];
+        progress  = true;
+      }
+    }
+  }
+  int nout = nreg;
+  if (m_cfg.coreSplitCoreMaxLayer > 0) {
+    // a core region keeps only its hits up to coreSplitCoreMaxLayer (a photon deposits early); deeper hits join the
+    // deep region, created here when the group has no deeper maximum
+    const int deep_id = static_cast<int>(kept.size());
+    for (std::size_t i = 0; i < n; ++i) {
+      const int r = region[i];
+      if (r < 0 || r >= deep_id) {
+        continue;
+      }
+      if (hits[v[i]].getLayer() > m_cfg.coreSplitCoreMaxLayer) {
+        region[i] = deep_id;
+        nout      = deep_id + 1;
+      }
+    }
+  }
+  std::vector<std::list<std::size_t>> out(nout);
+  for (std::size_t i = 0; i < n; ++i) {
+    // a hit no seed reaches (impossible in a connected group) stays with the first region
+    out[region[i] >= 0 ? region[i] : 0].push_back(v[i]);
+  }
+  for (auto& r : out) {
+    if (!r.empty()) {
+      regions.push_back(std::move(r));
     }
   }
 }
